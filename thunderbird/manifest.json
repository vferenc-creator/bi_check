{
  "manifest_version": 2,
  "name": "BI Output Monitor – e-mail figyelés",
  "short_name": "BI Monitor",
  "version": "1.0.0",
  "description": "A BI Output Monitor e-mailes figyelése: megnézi, hogy az időzített riport-e-mailek kimentek-e, és jelzi, ha valamelyik elmaradt.",
  "author": "Energofish Kft. – BI csapat",
  "homepage_url": "https://github.com/vferenc-creator/bi_check",
  "browser_specific_settings": {
    "gecko": { "id": "bimonitor@energofish.hu", "strict_min_version": "115.0" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png" },
  "permissions": ["accountsRead", "messagesRead", "storage", "notifications", "menus", "http://127.0.0.1/*"],
  "background": { "scripts": ["lib.js", "background.js"] },
  "browser_action": {
    "default_title": "BI Monitor – e-mail figyelés",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "64": "icons/icon-64.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
